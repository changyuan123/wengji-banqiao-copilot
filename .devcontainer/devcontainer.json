{
  "name": "Wengji Banqiao Copilot",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "postCreateCommand": "npm install",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/node_modules": true,
          "**/.next": true
        }
      },
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
