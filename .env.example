# AI 文案（免費優先：Groq → Gemini → OpenAI；都沒有則用菜單清料模板）
# Groq 免費額度：https://console.groq.com/keys
GROQ_API_KEY=
# 可選，預設 llama-3.3-70b-versatile
GROQ_MODEL=

# Google Gemini 免費額度：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI（可選加值）
OPENAI_API_KEY=
OPENAI_MODEL=

# 綠界 ECPay（信用卡定期定額）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# stage = 測試環境；production = 正式
ECPAY_MODE=stage

# 訂閱 cookie 簽章（任意長隨機字串）
SUBSCRIPTION_SECRET=change-me-to-a-long-random-string

# 正式網域（綠界 ReturnURL／PeriodReturnURL 會用到）
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# LINE 官方帳號一鍵推播（Messaging API Channel access token）
# https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
